# Copy this file to ".env" and fill in your own key.
# .env is in .gitignore, so your real key is never committed. Never put a key in .env.example.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use. A fast, cheap Flash model is plenty for this.
GEMINI_MODEL=gemini-3.8-flash
